{
  "functions": {
    "source": "functions",
    "runtime": "nodejs22"
  },
  "hosting": {
    "site": "hudaquran",
    "public": "webApp/build/dist/wasmJs/productionExecutable",
    "ignore": [
      "firebase.json",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/api/qf/**",
        "function": {
          "functionId": "quranFoundationProxy",
          "region": "us-central1"
        }
      },
      { "source": "/mushaf", "destination": "/mushaf.html" },
      { "source": "/hadith", "destination": "/hadith.html" },
      { "source": "/tafsir", "destination": "/tafsir.html" },
      { "source": "/dua", "destination": "/dua.html" },
      { "source": "/prayer", "destination": "/prayer.html" },
      { "source": "/reciters", "destination": "/reciters.html" },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "X-Frame-Options",
            "value": "DENY"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          }
        ]
      },
      {
        "source": "/config/**",
        "headers": [
          {
            "key": "Access-Control-Allow-Origin",
            "value": "*"
          },
          {
            "key": "Cache-Control",
            "value": "public, max-age=3600"
          }
        ]
      },
      {
        "source": "/.well-known/apple-app-site-association",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ]
      },
      {
        "source": "/.well-known/assetlinks.json",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ]
      }
    ]
  }
}
