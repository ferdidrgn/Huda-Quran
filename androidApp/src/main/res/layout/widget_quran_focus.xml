<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/quran_focus_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background_sakura"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/quran_focus_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="10dp"
        android:paddingVertical="6dp"
        android:maxLines="1"
        android:text="@string/widget_quran_focus_title"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/quran_focus_reading"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="2"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/quran_focus_progress_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:maxLines="1"
        android:textSize="12sp" />

    <ProgressBar
        android:id="@+id/quran_focus_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="8dp"
        android:layout_marginTop="5dp"
        android:max="604"
        android:progress="0" />
</LinearLayout>
