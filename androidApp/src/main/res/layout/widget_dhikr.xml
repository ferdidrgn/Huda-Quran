<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/dhikr_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:contentDescription="@string/dhikr_widget_accessibility"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/dhikr_widget_title"
            android:textColor="#D4B36A"
            android:textSize="11sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/dhikr_widget_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="0"
            android:textColor="#F3EEDF"
            android:textSize="30sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/dhikr_widget_increment"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:background="@drawable/widget_icon_bubble"
        android:contentDescription="@string/dhikr_widget_increment_accessibility"
        android:gravity="center"
        android:text="+1"
        android:textColor="#F3EEDF"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/dhikr_widget_reset"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="6dp"
        android:contentDescription="@string/dhikr_widget_reset_accessibility"
        android:gravity="center"
        android:text="↺"
        android:textColor="#A9B3A6"
        android:textSize="22sp" />
</LinearLayout>
