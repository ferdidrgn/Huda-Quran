<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/daily_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:contentDescription="@string/daily_content_widget_accessibility"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:id="@+id/daily_widget_reference"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#D4B36A"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/daily_widget_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:ellipsize="end"
        android:fontFamily="sans"
        android:maxLines="3"
        android:textColor="#F3EEDF"
        android:textSize="15sp" />
</LinearLayout>
