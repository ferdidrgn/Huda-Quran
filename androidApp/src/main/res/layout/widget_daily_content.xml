<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/daily_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background_sakura"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:id="@+id/daily_widget_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="10dp"
        android:paddingVertical="6dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="@string/widget_daily_ayah"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/daily_widget_arabic"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="end"
        android:fontFamily="serif"
        android:lineSpacingExtra="3dp"
        android:maxLines="2"
        android:textDirection="rtl"
        android:textSize="20sp" />

    <TextView
        android:id="@+id/daily_widget_text"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:fontFamily="sans"
        android:maxLines="4"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/daily_widget_reference"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/daily_widget_attribution"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:ellipsize="end"
        android:maxLines="6"
        android:textSize="10sp" />
</LinearLayout>
