<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-feature android:name="android.software.leanback" android:required="true" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" tools:node="remove" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" tools:node="remove" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" tools:node="remove" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" tools:node="remove" />
    <application android:banner="@drawable/tv_banner">
        <meta-data android:name="com.google.android.gms.car.application" tools:node="remove" />
        <meta-data android:name="com.google.android.gms.cast.framework.OPTIONS_PROVIDER_CLASS_NAME" tools:node="remove" />
        <meta-data android:name="com.google.android.gms.ads.APPLICATION_ID" tools:node="remove" />
        <property android:name="android.adservices.AD_SERVICES_CONFIG" tools:node="remove" />
        <activity android:name=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>
        <service android:name="org.ferdidrgn.hudaquran.audio.WearablePlaybackListenerService" tools:node="remove" />
        <service android:name="org.ferdidrgn.hudaquran.analytics.HudaQuranMessagingService" tools:node="remove" />
        <receiver android:name="org.ferdidrgn.hudaquran.notifications.PrayerAlarmReceiver" tools:node="remove" />
        <receiver android:name="org.ferdidrgn.hudaquran.notifications.ReminderRescheduleReceiver" tools:node="remove" />
        <receiver android:name="org.ferdidrgn.hudaquran.widget.LastReadWidgetProvider" tools:node="remove" />
        <receiver android:name="org.ferdidrgn.hudaquran.widget.QuranFocusWidgetProvider" tools:node="remove" />
        <receiver android:name="org.ferdidrgn.hudaquran.widget.PrayerWidgetProvider" tools:node="remove" />
        <receiver android:name="org.ferdidrgn.hudaquran.widget.TimeWidgetProvider" tools:node="remove" />
        <receiver android:name="org.ferdidrgn.hudaquran.widget.DailyContentWidgetProvider" tools:node="remove" />
        <receiver android:name="org.ferdidrgn.hudaquran.widget.DhikrWidgetProvider" tools:node="remove" />
        <receiver android:name="org.ferdidrgn.hudaquran.widget.HijriRamadanWidgetProvider" tools:node="remove" />
        <activity android:name="org.ferdidrgn.hudaquran.widget.WidgetConfigurationActivity" tools:node="remove" />
    </application>
</manifest>
